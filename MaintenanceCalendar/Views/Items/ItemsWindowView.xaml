<UserControl x:Class="MaintenanceCalendar.ItemsWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="所持品マスタ" FontSize="21" Margin="0,0,0,6"/>
            <TextBlock Text="行を選んで編集・コピー。チェックした行はまとめて削除・復旧できます。" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <CheckBox x:Name="IncludeDeleted" Content="削除済みも表示" Margin="3,8,3,5"/>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="AddButton" Content="追加"/>
            <Button x:Name="EditButton" Content="編集"/>
            <Button x:Name="CopyButton" Content="コピー"/>
            <Button x:Name="DeleteButton" Content="削除"/>
            <Button x:Name="RestoreButton" Content="削除解除"/>
            <Button x:Name="CheckAllButton" Content="全選択 / 解除"/>
        </WrapPanel>
        <DataGrid x:Name="Grid" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="選択" Binding="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource DataGridCheckBoxStyle}" Width="Auto"/>
                <DataGridTextColumn Header="メーカー" Binding="{Binding Manufacturer}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="モデル" Binding="{Binding Model}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="色" Binding="{Binding Color}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="購入日" Binding="{Binding PurchaseDate, StringFormat=yyyy/MM/dd}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="間隔" Binding="{Binding IntervalLabel}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="状態" Binding="{Binding Status}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
