<UserControl x:Class="MaintenanceCalendar.DashboardWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="所持品のダッシュボード" FontSize="23"/>
            <TextBlock Text="お気に入りと過ごした日々を、ひと目で。削除済みの所持品は含みません。" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            <primitives:UniformGrid x:Name="Metrics" Columns="2" Margin="0,6,0,8"/>
            <Grid x:Name="Cards"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
