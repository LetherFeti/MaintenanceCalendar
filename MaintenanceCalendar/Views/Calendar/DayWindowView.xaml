<UserControl x:Class="MaintenanceCalendar.DayWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="使用・お手入れを記録" FontSize="17" Margin="0,0,0,6"/>
        <WrapPanel DockPanel.Dock="Bottom" x:Name="Actions" Margin="0,8,0,0">
            <Button x:Name="UseButton" Content="使用"/>
            <Button x:Name="CareButton" Content="お手入れ"/>
            <Button x:Name="CancelCareButton" Content="お手入れ取消"/>
            <Button x:Name="SaveEventButton" Content="予定を保存" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
            <Button x:Name="DeleteEventButton" Content="予定を削除" Visibility="Collapsed" IsEnabled="False"/>
        </WrapPanel>
        <TabControl x:Name="Tabs">
            <TabItem Header="使用・お手入れ">
                <DockPanel TextElement.Foreground="{DynamicResource TextBrush}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="メーカー・モデル・色で検索"/>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBox x:Name="Search" MinWidth="220"/>
                            <CheckBox x:Name="ShowUsed" Content="使用済みだけを表示"/>
                            <CheckBox x:Name="ShowCared" Content="お手入れ済みだけを表示"/>
                        </WrapPanel>
                        <WrapPanel x:Name="BatchActions">
                            <Button x:Name="CheckAllButton" Content="全チェック / 解除"/>
                        </WrapPanel>
                        <TextBlock x:Name="BatchStatus"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                        <TextBlock x:Name="Status"/>
                        <TextBlock Text="お手入れメモ（表示のみ。編集は下部の「お手入れ」ボタン）" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="Memo" IsReadOnly="True" IsTabStop="False" Focusable="False" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="85"/>
                    </StackPanel>
                    <DataGrid x:Name="Grid" IsReadOnly="False" Margin="0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="メーカー" Binding="{Binding Manufacturer}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="モデル" Binding="{Binding Model}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="色" Binding="{Binding Color}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="使用" Binding="{Binding UseStatus}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="お手入れ" Binding="{Binding CareStatus}" ElementStyle="{StaticResource DataGridTextStyle}" IsReadOnly="True" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="EventTab" Header="予定">
                <ScrollViewer TextElement.Foreground="{DynamicResource TextBrush}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <DockPanel Margin="2,0,2,8">
                            <TextBlock x:Name="EventCount" Text="一覧から選ぶと編集できます" FontSize="12" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Right"/>
                            <TextBlock Text="この日の予定" FontSize="16"/>
                        </DockPanel>
                        <ListBox x:Name="EventList" MinHeight="90" MaxHeight="120" Margin="0,0,0,14">
                            <ListBox.ItemTemplate>
                                <DataTemplate><Border CornerRadius="9" Padding="10,7" Margin="2" Background="{DynamicResource CreamBrush}"><DockPanel><TextBlock Text="{Binding Start, StringFormat=HH:mm}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/></DockPanel></Border></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border CornerRadius="12" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="EventFormHeading" Text="新しい予定" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="タイトル"/><TextBox x:Name="EventTitle" MinWidth="260"/>
                                <WrapPanel Margin="0,4,0,6">
                                    <StackPanel Margin="0,0,14,4"><TextBlock Text="日付"/><DatePicker x:Name="EventDate" Width="155"/></StackPanel>
                                    <StackPanel Margin="0,0,14,4"><TextBlock Text="開始"/><TextBox x:Name="EventStart" Width="108" Text="09:00"/></StackPanel>
                                    <StackPanel Margin="0,0,14,4"><TextBlock Text="終了"/><TextBox x:Name="EventEnd" Width="108" Text="10:00"/></StackPanel>
                                </WrapPanel>
                                <TextBlock Text="繰り返し"/><ComboBox x:Name="Recurrence" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                                <StackPanel x:Name="RecurrenceEndField"><TextBlock Text="終了日（空欄は終了なし）"/><DatePicker x:Name="RecurrenceEnd" Width="190"/></StackPanel>
                                <StackPanel x:Name="EventScopeField" Visibility="Collapsed"><TextBlock Text="適用範囲"/><ComboBox x:Name="EventScope" DisplayMemberPath="Value" SelectedValuePath="Key"/></StackPanel>
                                <TextBlock Text="場所"/><TextBox x:Name="EventLocation" MinWidth="220"/>
                                <TextBlock Text="説明"/><TextBox x:Name="EventDescription" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="通知タイミング" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                <WrapPanel><CheckBox x:Name="NotifyPrevious" Content="前日" IsChecked="True"/><CheckBox x:Name="Notify15" Content="15分前" IsChecked="True"/><CheckBox x:Name="Notify5" Content="5分前" IsChecked="True"/></WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
