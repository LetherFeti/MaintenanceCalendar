<Window x:Class="MaintenanceCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MaintenanceCalendar"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}"
        Title="お手入れカレンダー" Width="450" Height="580" MinWidth="410" MinHeight="540"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Name="MenuItems" Header="所持品マスタ" Click="Button_Click"/>
            <MenuItem Name="MenuTemplates" Header="お手入れマスタ" Click="Button_Click"/>
            <MenuItem Name="MenuHistory" Header="手入れ・使用履歴" Click="Button_Click"/>
            <MenuItem Name="MenuDashboard" Header="ダッシュボード" Click="Button_Click"/>
            <MenuItem Name="MenuSettings" Header="設定" Click="Button_Click"/>
            <Separator/>
            <MenuItem Name="MenuLock" Header="誤クリック予防" IsCheckable="True" Click="Button_Click"/>
            <MenuItem Name="MenuExit" Header="終了" Click="Button_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <DockPanel Name="MainLayout" LastChildFill="True">
        <Border Name="Sidebar" DockPanel.Dock="Left" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Margin="6">
            <ScrollViewer Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Name="SidebarButtons" Margin="3"/>
            </ScrollViewer>
        </Border>
    <Grid Margin="10,10,10,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="お手入れカレンダー" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="暮らしを整える、小さな記録" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="所持品  /  空欄ですべて表示" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,4,0,2"/>
            <ContentControl Name="ComboHost"/>
        </StackPanel>
        <Border Grid.Row="2" Grid.RowSpan="3" CornerRadius="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,4,0,0"/>
        <Grid Grid.Row="2" Margin="8,10,8,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Name="PrevButton" Content="‹" ToolTip="前の月" AutomationProperties.Name="前の月" Click="Button_Click" Padding="9,3" Background="Transparent" BorderThickness="0"/>
            <TextBlock Name="MonthLabel" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button Name="NextButton" Grid.Column="2" Content="›" ToolTip="次の月" AutomationProperties.Name="次の月" Click="Button_Click" Padding="9,3" Background="Transparent" BorderThickness="0"/>
            <Button Name="TodayButton" Grid.Column="3" Content="今日" ToolTip="今日のある月に戻る" Click="Button_Click" Padding="9,3" FontSize="11" Background="{DynamicResource AccentSoftBrush}" BorderThickness="0"/>
        </Grid>
        <UniformGrid Grid.Row="3" Rows="1" Columns="7" Margin="0,6">
            <TextBlock Text="日" Foreground="#BB3030" HorizontalAlignment="Center"/>
            <TextBlock Text="月" HorizontalAlignment="Center"/><TextBlock Text="火" HorizontalAlignment="Center"/>
            <TextBlock Text="水" HorizontalAlignment="Center"/><TextBlock Text="木" HorizontalAlignment="Center"/>
            <TextBlock Text="金" HorizontalAlignment="Center"/><TextBlock Text="土" Foreground="#2859B0" HorizontalAlignment="Center"/>
        </UniformGrid>
        <UniformGrid Name="DaysPanel" Grid.Row="4" Rows="6" Columns="7" Margin="4,0,4,6"/>
        <StackPanel Grid.Row="5" Margin="0,6,0,0">
            <WrapPanel><TextBlock Name="TodayLegend" Margin="3"/><TextBlock Name="UseLegend" Margin="3"/><TextBlock Name="CareLegend" Margin="3"/></WrapPanel>
            <TextBlock Text="重なり：使用の塗り円 ＋ 手入れの円枠" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Name="LockStatus" Foreground="#A52A2A" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel Grid.Row="6" Margin="0,4,0,0">
            <Button Name="DueButton" Content="通知" Click="Button_Click" Style="{StaticResource PrimaryButton}"/>
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
