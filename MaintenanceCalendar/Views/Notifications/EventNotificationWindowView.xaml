<UserControl x:Class="MaintenanceCalendar.EventNotificationWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="16" Padding="20" Margin="12" Background="{DynamicResource CreamBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="EventTitle" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="WhenText" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock x:Name="LocationText" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="DescriptionText" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="TimingText" FontSize="12" TextWrapping="Wrap"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="AcknowledgeButton" Content="OK" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="SuppressButton" Content="以降、この予定を通知しない"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
