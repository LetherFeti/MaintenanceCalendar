<UserControl x:Class="MaintenanceCalendar.HistoryWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="使用・手入れ履歴" FontSize="21" Margin="0,0,0,6"/>
            <ComboBox x:Name="ItemCombo" Margin="0,0,0,6"/>
            <TextBlock x:Name="LastText" Margin="0,2" TextWrapping="Wrap"/>
            <TextBlock x:Name="PageText" Margin="0,2,0,6"/>
        </StackPanel>
        <TextBox x:Name="Memo" DockPanel.Dock="Bottom" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"/>
        <DataGrid x:Name="Grid" Margin="0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="日付" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" ElementStyle="{StaticResource DataGridTextStyle}" Width="*"/>
                <DataGridTextColumn Header="作業" Binding="{Binding WorkLabel}" ElementStyle="{StaticResource DataGridTextStyle}" Width="*"/>
                <DataGridTextColumn Header="お手入れメモ" Binding="{Binding Memo}" ElementStyle="{StaticResource DataGridTextStyle}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
